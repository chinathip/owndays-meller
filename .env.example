# Production hostname used as `metadataBase` (resolves the Open Graph image URL).
# Hostname only, without protocol, e.g. owndays-meller.vercel.app
# On Vercel this is set automatically at build time; set it manually on other hosts.
# When empty, http://localhost:3000 is used (fine for local development).
VERCEL_PROJECT_PRODUCTION_URL=

# Optional overrides. When empty, the URLs from the assignment are used.
PRODUCTS_API_URL=
NEXT_PUBLIC_IMAGE_BASE_URL=
